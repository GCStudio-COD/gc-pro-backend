// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Employee {
  id             String    @id @default(uuid())
  firstName      String
  lastName       String
  email          String    @unique
  passwordHash   String
  role           String    @default("Pending") // SuperAdmin, Admin, PM, Employee, Pending
  status         String    @default("Pending") // Unverified, Pending, Active, Inactive, On Leave
  profileImage   String?
  otpCode        String?
  otpExpiry      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  timeLogs       TimeLog[]
  attendanceLogs AttendanceLog[]
  leaveRequests  LeaveRequest[]
  notifications  Notification[]

  organizedMeetings Meeting[] @relation("MeetingOrganizer")
  participatingMeetings Meeting[] @relation("MeetingParticipants")
  plakyTasksAssigned PlakyTask[] @relation("PlakyTaskAssignee")
}

model TimeLog {
  id              String   @id @default(uuid())
  employeeId      String
  plakyTaskId     String?
  startTime       DateTime @default(now())
  endTime         DateTime?
  durationSeconds Int?
  createdAt       DateTime @default(now())

  employee   Employee   @relation(fields: [employeeId], references: [id])
  plakyTask  PlakyTask? @relation(fields: [plakyTaskId], references: [id])
}

model AttendanceLog {
  id              String    @id @default(uuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id])
  checkInTime     DateTime  @default(now())
  checkOutTime    DateTime?
  durationSeconds Int?
  date            DateTime  @default(now()) @db.Date
  createdAt       DateTime  @default(now())
}

model LeaveRequest {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  type        String   @default("Paid") // Paid, Sick, Emergency
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  reason      String
  status      String   @default("Pending") // Pending, Approved, Rejected, CancelPending, Cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String    @id @default(uuid())
  employeeId  String?
  employee    Employee? @relation(fields: [employeeId], references: [id])
  targetRole  String?
  creatorId   String?
  message     String
  type        String    @default("alert")
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Meeting {
  id          String    @id @default(uuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime
  type        String    @default("Internal") // Internal, Client, Team
  status      String    @default("Scheduled") // Scheduled, Completed, Cancelled
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizerId String
  organizer   Employee  @relation("MeetingOrganizer", fields: [organizerId], references: [id])
  participants Employee[] @relation("MeetingParticipants")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  spaces    Space[]
}

model Space {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  slug        String   @unique
  description String?
  icon        String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  boards      Board[]
}

model Board {
  id          String   @id @default(uuid())
  spaceId     String
  name        String
  slug        String   @unique
  description String?
  isFavorite  Boolean  @default(false)
  status      String   @default("Active") // Active, Completed
  columns     Json?    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  space       Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  groups      BoardGroup[]
}

model BoardGroup {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks     PlakyTask[]
}

model PlakyTask {
  id             String      @id @default(uuid())
  groupId        String
  parentTaskId   String?
  name           String
  assigneeId     String?
  dueDate        DateTime?
  content        String?     @db.Text
  creativeType   String?     // Video, Image, Text
  paymentStatus  String      @default("Pending") // Pending, Partially Paid, Paid, Not Applicable
  status         String      @default("To Do") // To Do, In Progress, Review, Approved, Done
  priority       String      @default("Medium") // Low, Medium, High, Urgent
  description    String?     @db.Text
  customFields   Json?       @default("{}")
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  group          BoardGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentTask     PlakyTask?  @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subTasks       PlakyTask[] @relation("SubTasks")
  assignee       Employee?   @relation("PlakyTaskAssignee", fields: [assigneeId], references: [id])
  timeLogs       TimeLog[]
}
